dist
dist-beam
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/
.lighthouseci/
.image-cache/
.claude/

# Share the cross-agent repository skills with Claude Code while keeping other
# machine-local Claude state and skills ignored.
!/.claude/
/.claude/*
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/repo-map/
!/.claude/skills/repo-map/SKILL.md
!/.claude/skills/token-efficient-navigation/
!/.claude/skills/token-efficient-navigation/SKILL.md
!/.claude/skills/dev-commands/
!/.claude/skills/dev-commands/SKILL.md
!/.claude/skills/verify-without-regression/
!/.claude/skills/verify-without-regression/SKILL.md
!/.claude/skills/large-repo-investigation/
!/.claude/skills/large-repo-investigation/SKILL.md
!/.claude/skills/repo-navigation/
!/.claude/skills/repo-navigation/SKILL.md
!/.claude/skills/visual-ui-debug/
!/.claude/skills/visual-ui-debug/SKILL.md
!/.claude/skills/state-agent-debug/
!/.claude/skills/state-agent-debug/SKILL.md
!/.claude/skills/safe-edit-verify/
!/.claude/skills/safe-edit-verify/SKILL.md
!/.claude/skills/commit-discipline/
!/.claude/skills/commit-discipline/SKILL.md
!/.claude/commands/
/.claude/commands/*
!/.claude/commands/fix-beam.md

# Env (never commit secrets)
.env
.env.*
!.env.example
ScentCast.env

# Local Supabase DB dumps (large; may contain sensitive data)
supabase-clean-backup-*/

# Supabase CLI local metadata (linked project, versions)
supabase/.temp/

# agent-run.mjs local command logs (never commit; keep .agent/config.json tracked)
.agent/runs/

# agent-context.mjs generated cache + latest report (never commit; regenerated on demand)
.agent/context-map.json
.agent/latest-context.md
