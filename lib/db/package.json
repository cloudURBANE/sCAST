{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./migrate": "./src/migrateCore.ts"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "generate": "drizzle-kit generate --config ./drizzle.config.ts",
    "migrate": "node --experimental-strip-types src/migrate.ts",
    "push": "node ./scripts/preflight-push.mjs && drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "node ./scripts/preflight-push.mjs && drizzle-kit push --force --config ./drizzle.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.23.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.0",
    "drizzle-kit": "^0.31.10"
  }
}
