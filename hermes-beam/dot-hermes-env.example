# Beam — excerpt to MERGE into ~/.hermes/.env  (secrets; never commit)

# Delegation token that authorizes Hermes to call the Beam MCP server.
# Mint it (owner/dev mode) with, from the repo:
#   pnpm --filter @workspace/api-server run beam:mint-token --user <USER_ID> --tenant <TENANT_ID>
# The minter and the MCP server must share the SAME BEAM_AGENT_TOKEN_SECRET.
BEAM_AGENT_TOKEN=paste-the-minted-token-here

# --- OpenRouter provider credential -----------------------------------------
# Beam routes its reasoning model through OpenRouter (pay-per-token, one key for
# many models — and the SAME provider the production in-process loop uses). Get a
# key at https://openrouter.ai/keys.
OPENROUTER_API_KEY=sk-or-...

# Legacy: Anthropic-direct still works if you prefer to pin Claude without
# OpenRouter (set provider: anthropic in config.yaml and uncomment). Not the
# default for Beam anymore.
# ANTHROPIC_API_KEY=sk-ant-...

# --- Live web research lane (server-side; OFF by default) --------------------
# These belong in the BEAM MCP SERVER's environment, not Hermes — the research
# tool runs on the server the MCP exposes, so the agent (Hermes or the in-app
# loop) never sees these keys. The lane stays inert until BOTH the flag below and
# OPENROUTER_API_KEY are set. Full guide: docs/beam-agent/08-live-research-lane.md
BEAM_RESEARCH_ENABLED=false

# Per-lane OpenRouter model slugs. Defaults shown; VERIFY each against the live
# OpenRouter catalog before enabling (slugs drift, though all four defaults below
# were verified live on 2026-06-14). Never use *:online / openrouter/auto /
# openrouter/fusion — they are rejected (cost-opaque) and fall back to defaults.
# BEAM_RESEARCH_MODEL_SINGLE=minimax/minimax-m3
# BEAM_RESEARCH_MODEL_STANDARD=minimax/minimax-m3
# BEAM_RESEARCH_MODEL_PREMIUM=moonshotai/kimi-k2.7-code
# BEAM_RESEARCH_MODEL_DEGRADED=stepfun/step-3.7-flash

# Web-search engine for the OpenRouter `web` plugin: exa | parallel | native.
# BEAM_RESEARCH_ENGINE=exa
# Comma-separated domain allowlist (tight = cheaper + higher quality). Empty env
# uses the built-in fragrance defaults (fragrantica, parfumo, basenotes, luckyscent).
# BEAM_RESEARCH_INCLUDE_DOMAINS=fragrantica.com,parfumo.com,basenotes.com,luckyscent.com
