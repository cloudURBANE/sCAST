{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "hermes-beam/deploy/Dockerfile.hermes-agent"
  },
  "deploy": {
    "startCommand": "/init /opt/hermes/docker/main-wrapper.sh gateway run",
    "restartPolicyType": "ON_FAILURE",
    "numReplicas": 1
  }
}
