# syntax=docker/dockerfile:1

# Beam's Hermes runtime image. Use NousResearch's published container instead of
# executing the external installer during our Railway build.
FROM nousresearch/hermes-agent:v2026.6.19

USER root

ENV HERMES_HOME=/opt/data
ENV HERMES_WRITE_SAFE_ROOT=/opt/data

# Seed the Beam profile into Hermes' mutable data directory. Railway injects
# secrets at runtime; no credentials are baked into this image.
COPY --chown=10000:10000 hermes-beam/AGENTS.md hermes-beam/SOUL.md /opt/data/
COPY --chown=10000:10000 hermes-beam/beam-context /opt/data/beam-context
COPY --chown=10000:10000 hermes-beam/skills /opt/data/skills
COPY --chown=10000:10000 hermes-beam/config.example.yaml /opt/data/config.yaml

CMD ["gateway", "run"]
