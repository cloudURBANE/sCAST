{
  "id": "/",
  "name": "ScentBeam",
  "short_name": "ScentBeam",
  "description": "Your scent. Perfected.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "lang": "en",
  "dir": "ltr",
  "categories": ["lifestyle", "shopping", "utilities"],
  "theme_color": "#000000",
  "background_color": "#000000",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icons/app-icon-black/android-chrome-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/app-icon-black/android-chrome-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable/scentbeam-maskable-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/maskable/scentbeam-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Search & Vault",
      "short_name": "Vault",
      "description": "Search fragrances and open your scent vault",
      "url": "/?source=pwa-shortcut",
      "icons": [
        { "src": "/icons/app-icon-black/android-chrome-192x192.png", "sizes": "192x192", "type": "image/png" }
      ]
    },
    {
      "name": "Scent Arena",
      "short_name": "Arena",
      "description": "Head-to-head fragrance battles",
      "url": "/arena?source=pwa-shortcut",
      "icons": [
        { "src": "/icons/app-icon-black/android-chrome-192x192.png", "sizes": "192x192", "type": "image/png" }
      ]
    },
    {
      "name": "Community",
      "short_name": "Community",
      "description": "See what the community is wearing",
      "url": "/community?source=pwa-shortcut",
      "icons": [
        { "src": "/icons/app-icon-black/android-chrome-192x192.png", "sizes": "192x192", "type": "image/png" }
      ]
    }
  ]
}
