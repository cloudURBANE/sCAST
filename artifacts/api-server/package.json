{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "backtest:scent-facts": "node --experimental-strip-types src/lib/scent-facts/backtest.ts",
    "beam:mcp:build": "node ./build-beam-mcp.mjs",
    "beam:mcp": "pnpm run beam:mcp:build && node --enable-source-maps ./dist-beam/beam-mcp.mjs",
    "start:beam-mcp": "node --enable-source-maps ./dist-beam/beam-mcp.mjs",
    "beam:mint-token": "node --experimental-strip-types src/beam-agent/mcp/mintOwnerToken.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@sentry/node": "^10.70.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/scent-weather-engine": "workspace:*",
    "axios": "^1.19.0",
    "cheerio": "^1.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "firebase-admin": "^14.2.0",
    "form-data": "^4.0.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.1",
    "pino": "^9",
    "pino-http": "^11",
    "sharp": "^0.35.3",
    "web-push": "^3.6.7",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "thread-stream": "4.2.0"
  }
}
