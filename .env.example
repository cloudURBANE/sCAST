# =============================================================================
# Scent Cast — production / Railway (.env at repo root)
# Copy to .env and fill in values. Railway: set the same keys in the service Variables UI.
# =============================================================================

# --- Required for HTTP server (Railway sets PORT automatically) ---
NODE_ENV=production
PORT=3000

# Number of reverse proxies in front of Express, used for Express `trust proxy`
# so per-IP rate limits key on the real client IP instead of a client-forged
# X-Forwarded-For entry. 1 = direct Railway; 2 = CloudFront → Railway.
# Defaults to 1 when unset. Setting this too high lets clients spoof their IP.
TRUST_PROXY_HOPS=1

# Comma-separated exact origins allowed to make cross-origin browser requests to
# the API. In production the SPA is same-origin (CloudFront proxies /api/*), so
# this can stay EMPTY — unset means no CORS headers are emitted and third-party
# websites cannot drive the cost-bearing endpoints from visitors' browsers.
# Set it only when a browser app on another origin must call this API directly.
# Dev example: CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGINS=

# Emit Strict-Transport-Security from Express itself. Leave false behind
# CloudFront/Railway (the edge sets HSTS); set true only for a self-hosted
# deployment where this Express process terminates TLS directly.
HSTS_ENABLED=false

# Bearer-token lifetime (production-readiness C2). A token is rejected once it is
# older than TOKEN_ABSOLUTE_TTL_DAYS from issue, or unused for
# TOKEN_IDLE_TTL_DAYS. Defaults are generous; lower them to shorten sessions.
TOKEN_ABSOLUTE_TTL_DAYS=90
TOKEN_IDLE_TTL_DAYS=30

# Postgres — required at startup (wardrobe, auth, share, catalog routes use Drizzle)
DATABASE_URL=postgresql://user:password@host:5432/dbname
# VERIFIED database TLS (production). Set to the provider's CA certificate so
# the connection is verified, not just encrypted. Two accepted forms:
#   - inline PEM in one line with \n escapes (same convention as FIREBASE_PRIVATE_KEY)
#   - a path to a .pem file readable by the server process
# Supabase: Project Settings → Database → SSL → download the CA certificate.
# When set, verification is ON regardless of the override below. When unset but
# the URL has sslmode, the server boots with relaxed verification and logs a
# warning — treat that warning as a deploy TODO, not a steady state.
DATABASE_SSL_CA=
# LOCAL DEV ONLY: TLS without verification (invisible to MITM). Do not set in
# production — configure DATABASE_SSL_CA instead.
DATABASE_SSL_REJECT_UNAUTHORIZED=

# Versioned schema migrations (lib/db/migrations). true = apply pending
# migrations at boot, before the readiness-gated traffic cutover — the sanctioned
# production path (single replica; drizzle also takes an advisory lock). Off by
# default so local dev with `push` is unaffected. One-off manual apply:
#   DATABASE_URL=... pnpm --filter @workspace/db run migrate
RUN_MIGRATIONS_ON_BOOT=true
# Override only if the migrations folder is not at lib/db/migrations relative to
# the process working directory (bundled/self-hosted layouts).
MIGRATIONS_DIR=

# --- Shared state backend (Redis) — OPTIONAL, off by default ---
# Leave UNSET and the API uses process-local in-memory state for rate limits and
# Beam Agent session memory (the current single-replica behavior; nothing
# changes). Set REDIS_URL and those stores move to a shared Redis instance so the
# limit holds across replicas and session context survives a redeploy — the
# prerequisite for running more than one API replica. The client fails open: if
# Redis is unreachable each store degrades back to in-memory, so a cache outage
# never takes the API down. Provisioning Redis + setting this var is the only
# step to turn it on; no code change.
# NOTE: the in-process SSE run registry in /api/beam-agent is NOT yet shared, so
# keep railway.json numReplicas:1 until that is migrated (see the Redis plan).
# Example (Railway addon): REDIS_URL=redis://default:password@host:6379
# Example (Upstash):       REDIS_URL=rediss://default:password@host:6379
REDIS_URL=

# --- Frontend build (Vite — safe defaults for SPA served under Express) ---
# Path prefix for static assets; use "/" when the app is served at the domain root.
BASE_PATH=/

# --- Optional API integrations ---
# OpenWeatherMap key. Weather has two providers for redundancy: keyless Open-Meteo
# is primary (drives current conditions + the 7-day outlook), and OpenWeatherMap is
# the fallback when Open-Meteo is unreachable. This key ALSO powers reverse
# geocoding so the dashboard shows the real locality (e.g. "Forney, Texas") instead
# of the IANA timezone city ("Chicago"). When unset, weather still works keyless but
# the location label falls back to the timezone city.
WEATHER_API_KEY=
# Serper.dev image search (used by fragrance image pipeline).
# KEY POOL: to rotate across multiple free accounts, set SERPER_API_KEYS to a
# comma-separated list. The backend drains one key until it hits "out of credits"
# (401/402/403) or rate limit (429), then automatically rotates to the next — no
# redeploy. SERPER_API_KEY (singular) still works and is merged into the pool.
# Example: SERPER_API_KEYS=key_aaa,key_bbb,key_ccc
SERPER_API_KEYS=
SERPER_API_KEY=
# Optional override; defaults to https://google.serper.dev/images
SERPER_IMAGE_API_URL=
# Image candidate provider for the fragrance image pipeline:
#   serper (default) — Serper.dev /images, billed against the SERPER key pool above.
#   engine           — engine's Decodo-backed GET /api/fragrances/image-search
#                      (uses FRAGRANCE_ENGINE_URL below; no Serper key needed).
# Keep `serper` until the engine image-search route is deployed, then flip to
# `engine` to move image spend onto the cheaper Decodo pool. Set IMAGE_PROVIDER=engine.
IMAGE_PROVIDER=serper
# Poof background removal. Same key-pool behavior: REMOVE_BG_API_KEYS is a
# comma-separated pool; REMOVE_BG_API_KEY (singular) is merged in for compat.
# Example: REMOVE_BG_API_KEYS=poof_aaa,poof_bbb,poof_ccc
REMOVE_BG_API_KEYS=
REMOVE_BG_API_KEY=
JINA_API_KEY=
OPENAI_API_KEY=
# GEMINI_API_KEY also enables the image vision-validation gate: automatic image
# winners are checked by Gemini Flash ("single bottle of {brand} {name}? yes/no")
# before being persisted. Fail-open (no key / any error = pass-through).
# Kill switch: IMAGE_VISION_GATE=off
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Beam Agent (the read-only fragrance concierge at /api/beam-agent)
# ---------------------------------------------------------------------------
# The agent is mounted and live. With NO model key set it degrades gracefully:
# the SPA falls back to the scripted /api/scent-mission path, so leaving this
# whole block empty is safe. Set ONE provider key to turn the real agent on.
#
# Provider is auto-selected: OpenRouter (production) when OPENROUTER_API_KEY is
# present, else Anthropic-direct when ANTHROPIC_API_KEY is present. Force one
# with BEAM_AGENT_PROVIDER=openrouter|anthropic.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# BEAM_AGENT_PROVIDER=openrouter
#
# Global on/off kill-switch for the in-process Beam Agent (default ON).
# Set to false/0/off/no/disabled (case/space-insensitive) to turn the live agent
# OFF for ALL users — every run then emits a graceful beam_disabled failure and
# the SPA silently falls back to the scripted Scent Mission. Read fresh per
# request: change it in the Railway api-server env and restart to toggle in
# production. Anything else (including unset) = ON.
BEAM_AGENT_ENABLED=true
#
# Cost-optimized model ladder (see docs/beam-agent/10-cost-optimized-model-stack.md).
# Slugs are provider-namespaced and DRIFT — confirm the exact slug in your provider
# dashboard before relying on a default (an unprovisioned slug fails live runs).
#
# The OpenRouter defaults are a free/cheap stack of three models:
#   - tencent/hy3-preview:free     (free concierge / orchestration / premium-orch)
#   - tencent/hy3-preview          (strong synthesis closer)
#   - nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free  (gated deep strategy)
# ANY provider/model can be pinned per-deployment via the env vars below (e.g. on
# Railway) — the defaults are only a starting point, not a lock-in.
#
# DO NOT point any lane at an OpenAI "harmony"/gpt-oss slug: those emit tool calls
# as control markup in the plain content channel, which the tool-free synthesis
# turn scrubs to an empty answer → the "I couldn't lock in a confident match"
# stall. hy3 routes tools structurally, so it is the harmony-free default.
#
# Default concierge (tool-calling orchestration + the cheap lane).
#   OpenRouter default: tencent/hy3-preview:free
#   Anthropic default:  claude-haiku-4-5-20251001
# BEAM_AGENT_MODEL=
#
# Strong/premium model: the final synthesis turn, and the whole premium lane
# (long / multi-turn / nuanced sessions, chosen deterministically at the route).
#   OpenRouter default: tencent/hy3-preview
#   Anthropic default:  claude-sonnet-4-6
# BEAM_AGENT_MODEL_STRONG=
#
# Deep-strategy model: reserved for gated deep workflows (the hot path never
# auto-routes here). Exposed for telemetry / future deep gating.
#   OpenRouter default: nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
#   Anthropic default:  claude-sonnet-4-6
# BEAM_AGENT_MODEL_DEEP=
#
# Premium-lane ORCHESTRATION tier (tool-calling turns on nuanced/multi-item
# missions). Same cheap free model as the default lane, NOT the synthesis closer —
# never set this to a Sonnet/expensive slug or every premium tool turn pays closer
# prices (the ~$0.60/mission blowup). Default: tencent/hy3-preview:free (OpenRouter)
# or the default concierge (Anthropic-direct, which has no mid-tier).
# BEAM_AGENT_MODEL_PREMIUM=
#
# Lane-aware SYNTHESIS closer (the final, tool-free recommendation). Each lane can
# close on a different model without code changes — e.g. send everyday default-lane
# traffic to a cheap reasoning closer while keeping premium on Sonnet. Unset → the
# strong slug (BEAM_AGENT_MODEL_STRONG / provider default), i.e. today's behavior.
# Any slug the active provider accepts works (OpenRouter routes DeepSeek/MiniMax/
# Anthropic alike), so DeepSeek V4 is a drop-in A/B:
#   BEAM_AGENT_SYNTH_MODEL_DEFAULT=deepseek/deepseek-v4-flash
#   BEAM_AGENT_SYNTH_MODEL_PREMIUM=deepseek/deepseek-v4-pro
# BEAM_AGENT_SYNTH_MODEL_DEFAULT=
# BEAM_AGENT_SYNTH_MODEL_PREMIUM=
#
# Per-lane run guardrails. Defaults match the historical hardcoded limits, so unset
# = unchanged. maxTurns is clamped to the hard ceiling (8) — env can only LOWER it.
# Lowering free-lane tool rounds + the synthesis token cap bounds the worst-case
# bill, which matters for reasoning-mode closers (their trace bills as output).
#   BEAM_AGENT_MAX_TURNS_DEFAULT  (default 8)   tool rounds, default lane
#   BEAM_AGENT_MAX_TURNS_PREMIUM  (default 8)   tool rounds, premium lane
#   BEAM_AGENT_ORCH_MAX_TOKENS    (default 2048) per orchestration turn
#   BEAM_AGENT_SYNTH_MAX_TOKENS   (default 4096) closing synthesis + repair
# BEAM_AGENT_MAX_TURNS_DEFAULT=
# BEAM_AGENT_MAX_TURNS_PREMIUM=
# BEAM_AGENT_ORCH_MAX_TOKENS=
# BEAM_AGENT_SYNTH_MAX_TOKENS=
#
# OpenRouter attribution headers (optional, non-secret, recommended).
# OPENROUTER_SITE_URL=
# OPENROUTER_APP_TITLE=ScentBeam Beam Agent
#
# Live web-research lane (beam_research_web). Off unless BOTH are set; the tool
# is not even exposed otherwise. Requires OPENROUTER_API_KEY above.
# BEAM_RESEARCH_ENABLED=true
#
# Hybrid-corpus external discovery (beam_discover_external). ON by default — it is
# the ONLY tool that reaches the live Python engine's search + /details enrichment,
# so disabling it leaves the agent unable to fetch real Fragrantica/Basenotes data.
# It searches the engine (FRAGRANCE_ENGINE_URL / VITE_FRAGRANCE_API_URL) for
# fragrances beyond the local catalog and queues each surfaced pick for enrichment
# (caches into the catalog only when the enrichment worker is enabled). Detail
# (Decodo-egress) fetches are capped per call (BEAM_LIMITS.maxExternalDetailFetch=3)
# and per run (BEAM_EXTERNAL_DETAIL_RUN_CAP, default 6) to bound spend. Set to
# false/0/off ONLY for a lean/offline deploy that must never reach the paid engine.
# BEAM_DISCOVER_EXTERNAL_ENABLED=false
# BEAM_EXTERNAL_DETAIL_RUN_CAP=6
# BEAM_DISCOVER_SEARCH_TIMEOUT_MS=6000
# BEAM_DISCOVER_DETAIL_TIMEOUT_MS=9000

# Reimagine bottle image (OpenAI images.edits). Leave ENABLE_REIMAGINE unset or
# set it to "true" to expose POST /api/reimagine-bottle-image; any other value
# returns 403. Allowed models: gpt-image-2, gpt-image-1. Default model when
# neither the request body nor this env var specifies one: gpt-image-2.
ENABLE_REIMAGINE=true
OPENAI_REIMAGINE_MODEL=gpt-image-2
# Quality tier (low|medium|high|auto). Output is downscaled to 768px WebP, so
# "medium" looks the same as "high" while costing ~4x less in output tokens.
# This is the single biggest cost lever. Default: medium.
OPENAI_REIMAGINE_QUALITY=medium
# Max edge (px) of the reference PNG sent to OpenAI. Image-INPUT tokens scale
# with this — the bulk of an edits bill. Clamped 512..2048. Default: 1024.
OPENAI_REIMAGINE_INPUT_DIM=1024
# Per-IP hourly cap on the unauthenticated reimagine endpoint. Default: 10.
REIMAGINE_RATE_LIMIT_PER_HOUR=10

# Per-IP 5-minute caps on the other unauthenticated cost-bearing endpoints.
# Defaults sit far above legitimate single-user rates; raise/lower to taste.
# POST /api/scent-profile (guest add flow; engine scrape on cache miss). Default: 30.
SCENT_PROFILE_RATE_LIMIT=30
# POST /api/search-scent (engine-down fallback search; full profile build). Default: 60.
SEARCH_SCENT_RATE_LIMIT=60
# POST /api/refresh-image (per-tile image re-search; Serper spend). Default: 20.
REFRESH_IMAGE_RATE_LIMIT=20
# POST /api/scent-facts/enrich (Serper + Jina + LLM per call, uncached). Default: 10.
SCENT_FACTS_RATE_LIMIT=10

# Auth + write rate limits (production-readiness C4).
# Per-IP 10-minute cap on the OAuth surface (start/callback/exchange/logout). A
# normal login is ~3 hits; raise for a large shared NAT. Default: 20.
OAUTH_RATE_LIMIT=20
# Per-USER per-minute caps on mutating routes (keyed on the account, applied
# after auth). Generous — they stop runaway loops/floods, not normal use.
WARDROBE_WRITE_RATE_LIMIT=120
COMMUNITY_WRITE_RATE_LIMIT=60

# Rakuten Advertising affiliate APIs (optional; backend only)
# OAuth application credentials from the Rakuten Advertising Developer Portal.
RAKUTEN_ADVERTISING_CLIENT_ID=
RAKUTEN_ADVERTISING_CLIENT_SECRET=
# Numeric publisher Site ID (SID) from the Rakuten Advertising publisher dashboard.
RAKUTEN_ADVERTISING_SID=
# Optional override; defaults to https://api.linksynergy.com and posts to /token for OAuth access tokens.
RAKUTEN_ADVERTISING_BASE_URL=https://api.linksynergy.com
# Optional comma/pipe/space-delimited advertiser MIDs to search first.
# When provided, Scent Cast checks advertiser details and skips known non-deep-link advertisers.
RAKUTEN_ADVERTISING_MIDS=
# Optional u1 tracking value appended through the Deep Links API.
RAKUTEN_ADVERTISING_U1=scentcast
# Optional Product Search page size for buy-link resolution; max 100.
RAKUTEN_ADVERTISING_PRODUCT_MAX=10

# Cached affiliate buy-link freshness (optional; backend only)
# Cached affiliate_links rows older than this are treated as stale: they are
# skipped on public share pages (falling back to a search link) and counted by
# GET /api/admin/buy-links/freshness. Defaults to 30 days when unset/invalid.
BUY_LINK_CACHE_TTL_MS=2592000000

# Amazon Associates / Amazon Affiliate
AMAZON_AFFILIATE_ENABLED=false
AMAZON_ASSOCIATE_TAG=
AMAZON_MARKETPLACE=amazon.com

# Optional: only needed for future Amazon Product Advertising API / Creator API integration
AMAZON_ACCESS_KEY_ID=
AMAZON_SECRET_ACCESS_KEY=
AMAZON_PARTNER_TAG=
AMAZON_PARTNER_TYPE=Associates
AMAZON_REGION=us-east-1

# --- Firebase Firestore cache (optional — omit any key to disable cache gracefully) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# PEM contents with literal \n for newlines when stored in a single line
FIREBASE_PRIVATE_KEY=
# Optional Firebase Storage bucket for processed image objects. Production must
# configure Firebase Storage or Supabase Storage; local object refs are not durable.
FIREBASE_STORAGE_BUCKET=
# Optional public CDN/base URL for Firebase Storage objects.
FIREBASE_STORAGE_PUBLIC_BASE_URL=

# --- Supabase Storage image objects (optional backend-only fallback) ---
# Use a service role key only on the backend/Railway. Never expose it through VITE_*.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_IMAGE_BUCKET=
# Optional public CDN/base URL for the image bucket.
SUPABASE_IMAGE_PUBLIC_URL_BASE=

# --- Local image object storage (dev only; never use for production DB refs) ---
# Set this to true only against a disposable/local database.
IMAGE_ALLOW_LOCAL_OBJECT_STORAGE=false
IMAGE_LOCAL_STORAGE_DIR=

# --- Image proxy in-process cache (optional; GET /api/image-proxy, Phase 2) ---
# After Phase 1 the proxy only serves genuinely third-party hotlink sources, so
# this LRU byte cache + in-flight dedup + concurrency cap keeps those cheap. The
# byte budget defaults conservatively because the cache is process-local (mind
# the box's memory). Set IMAGE_PROXY_CACHE_MAX_BYTES=0 to disable caching.
IMAGE_PROXY_CACHE_MAX_BYTES=67108864   # 64 MiB (default)
IMAGE_PROXY_CACHE_TTL_MS=3600000       # 1 hour (default)
IMAGE_PROXY_MAX_CONCURRENCY=8          # max concurrent upstream image fetches (default)
IMAGE_PROXY_MAX_QUEUE=256              # max queued upstream image fetches before 429 (default)

# --- Admin ops (backend only — never expose via VITE_* or the browser) ---
# Required for `pnpm --filter @workspace/scripts rebuild-user` and
# POST /api/admin/wardrobe/rebuild (x-admin-secret header). Rotate if leaked.
ADMIN_SECRET=

# Comma/whitespace-separated allowlist of admin user emails (case-insensitive).
# A signed-in user whose email is listed may use admin-only, user-authenticated
# routes such as POST /api/admin/bottle-image/upload, and sees the admin bottle-
# image uploader in the SPA. Empty = no admins (feature stays hidden/forbidden).
# No address is hardcoded in source, so every admin — including the project
# owner — MUST be listed here (Railway: set this in the service Variables).
ADMIN_EMAILS=

# --- Web Push notifications (optional — omit to disable push entirely) ---
# VAPID keypair identifying this app server to browser push services. Generate
# once with `npx web-push generate-vapid-keys` and paste below. With these unset
# the push endpoints return 503 and the SPA hides the notifications toggle — the
# rest of the PWA (offline, install) is unaffected. Requires the
# push_subscriptions table: run `pnpm --filter @workspace/db run push`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URI sent with each push (mailto: or https:). Defaults to a mailto.
VAPID_SUBJECT=mailto:support@scentbeam.com

# Enrichment queue has two independently-gated halves — BOTH must be on for it to
# do anything end to end:
#   ENRICHMENT_QUEUE_ENABLED  — the PRODUCER (enqueues jobs on incomplete details)
#   ENRICHMENT_WORKER_ENABLED — the CONSUMER (startEnrichmentWorker completes jobs
#                               and fires their "curation complete" notification)
# With the worker on but the producer off, the worker runs but consumes a queue
# nothing feeds; with the producer on but the worker off, jobs pile up unprocessed.
# Set both to `true` in any environment that should deliver curation notifications.
ENRICHMENT_QUEUE_ENABLED=true
ENRICHMENT_WORKER_ENABLED=true

# --- Google OAuth (optional — omit to get 503 from auth routes) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Canonical site URL for OAuth redirects (no trailing slash). Set when using Cloudflare Tunnel or
# Railway so redirects match Google Console — overrides REPLIT_* when set.
# With Vercel frontend + Railway API, you can leave this unset if the API receives X-Forwarded-Host
# from the proxy; otherwise set to your public Vercel URL (e.g. https://scent-cast-explore.vercel.app).
# Example: https://abc-xyz.trycloudflare.com
OAUTH_PUBLIC_URL=

# Public web app URL (used for OAuth base if OAUTH_PUBLIC_URL unset). Vercel: https://scent-cast-explore.vercel.app
PUBLIC_APP_URL=
FRONTEND_URL=

# Vercel only: origin of the Express API (Railway etc.). Proxied by middleware.js as /api/*.
# Must be one origin only, with no commas and no trailing slash.
# Example: BACKEND_ORIGIN=https://your-railway-api.up.railway.app
BACKEND_ORIGIN=

# --- Replit-only canonical URLs (optional — on Railway/tunnel, clear these or set OAUTH_PUBLIC_URL) ---
REPLIT_DOMAINS=
REPLIT_DEV_DOMAIN=

# --- Beam Agent (Scent Mission concierge — tool-calling runtime) ---
# REQUIRED in the deployed api-server env to make the live agent actually run.
# Without a provider key, /api/beam-agent runs return `model_unavailable` and the
# SPA silently falls back to the scripted /api/scent-mission path (looks fine, but
# the agent never runs). The startup log prints which provider was selected, or a
# warning if none. See docs/beam-agent/09-deploy-checklist.md.
# Production default — OpenRouter (one key, many models, pay-per-token):
OPENROUTER_API_KEY=
# Fallback — Anthropic-direct, used only when OPENROUTER_API_KEY is unset:
ANTHROPIC_API_KEY=
# Optional: force a provider regardless of which keys are present (openrouter|anthropic).
BEAM_AGENT_PROVIDER=
# Optional: enable the live web-research lane (also needs OPENROUTER_API_KEY).
BEAM_RESEARCH_ENABLED=false

# --- Logging ---
LOG_LEVEL=info

# --- Frontend: only VITE_* variables are exposed to the browser bundle.
# Optional: bypass Vercel middleware for browser-side /api calls by calling backend directly.
# Must be one origin only, with no commas and no trailing slash. Leave empty to use same-origin /api.
# Example: VITE_API_BASE_URL=https://your-railway-api.up.railway.app
VITE_API_BASE_URL=
# Optional: comma-separated CDN origins/prefixes we control that serve our own
# already-processed image objects (e.g. a Supabase public bucket base or a CDN
# domain fronting it). URLs under these — and any URL containing images/processed/
# — render directly in the browser instead of going through /api/image-proxy.
# Leave empty to rely on the images/processed/ path heuristic alone.
# Example: VITE_IMAGE_CDN_BASES=https://abc.supabase.co/storage/v1/object/public/images
#
# Phase 3 (edge/CDN): to front storage with a real CDN, point the backend's
# storage public base at the CDN domain AND list it here so the SPA treats it as
# direct, then add a matching <link rel="preconnect"> in index.html:
#   SUPABASE_IMAGE_PUBLIC_URL_BASE=https://cdn.example.com/storage/v1/object/public/images
#   VITE_IMAGE_CDN_BASES=https://cdn.example.com/storage/v1/object/public/images
VITE_IMAGE_CDN_BASES=
# Optional: endpoint that receives lightweight client image-load metrics
# (navigator.sendBeacon JSON: {outcome, ms, attempts, usedProxyFallback, url}).
# Leave empty to only dispatch the in-page `scentbeam:image-metric` event.
VITE_IMAGE_METRICS_URL=
# Optional: endpoint that receives Web Vitals field metrics
# (navigator.sendBeacon JSON with name, value, rating, route, deviceClass,
# connectionType, authState, and vaultSizeBucket). Leave empty to only dispatch
# the in-page `scentbeam:web-vital` event.
VITE_WEB_VITALS_URL=
# Railway Python fragrance engine API. Browser code calls this directly for search/details intelligence.
VITE_FRAGRANCE_API_URL=https://srt-scent-engine-production.up.railway.app
# Server-side proxy target for /api/engine/* (Express). Defaults to VITE_FRAGRANCE_API_URL when unset.
FRAGRANCE_ENGINE_URL=https://srt-scent-engine-production.up.railway.app
# VITE_PUBLIC_APP_NAME=SCENTBEAM
