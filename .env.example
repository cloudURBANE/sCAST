# =============================================================================
# Scent Cast — production / Railway (.env at repo root)
# Copy to .env and fill in values. Railway: set the same keys in the service Variables UI.
# =============================================================================

# --- Required for HTTP server (Railway sets PORT automatically) ---
NODE_ENV=production
PORT=3000

# Postgres — required at startup (wardrobe, auth, share, catalog routes use Drizzle)
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Optional TLS verification override for managed DBs (e.g. Supabase pooler).
# Set to false when you see certificate chain errors in Node.
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# --- Frontend build (Vite — safe defaults for SPA served under Express) ---
# Path prefix for static assets; use "/" when the app is served at the domain root.
BASE_PATH=/

# --- Optional API integrations ---
WEATHER_API_KEY=
# Serper.dev image search (used by fragrance image pipeline).
# KEY POOL: to rotate across multiple free accounts, set SERPER_API_KEYS to a
# comma-separated list. The backend drains one key until it hits "out of credits"
# (401/402/403) or rate limit (429), then automatically rotates to the next — no
# redeploy. SERPER_API_KEY (singular) still works and is merged into the pool.
# Example: SERPER_API_KEYS=key_aaa,key_bbb,key_ccc
SERPER_API_KEYS=
SERPER_API_KEY=
# Optional override; defaults to https://google.serper.dev/images
SERPER_IMAGE_API_URL=
# Poof background removal. Same key-pool behavior: REMOVE_BG_API_KEYS is a
# comma-separated pool; REMOVE_BG_API_KEY (singular) is merged in for compat.
# Example: REMOVE_BG_API_KEYS=poof_aaa,poof_bbb,poof_ccc
REMOVE_BG_API_KEYS=
REMOVE_BG_API_KEY=
JINA_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Reimagine bottle image (OpenAI images.edits). Leave ENABLE_REIMAGINE unset or
# set it to "true" to expose POST /api/reimagine-bottle-image; any other value
# returns 403. Allowed models: gpt-image-1, gpt-image-1-mini, gpt-image-2.
# Default model when neither the request body nor this env var specifies one:
# gpt-image-1.
ENABLE_REIMAGINE=true
OPENAI_REIMAGINE_MODEL=gpt-image-1

# Rakuten Advertising affiliate APIs (optional; backend only)
# OAuth application credentials from the Rakuten Advertising Developer Portal.
RAKUTEN_ADVERTISING_CLIENT_ID=
RAKUTEN_ADVERTISING_CLIENT_SECRET=
# Numeric publisher Site ID (SID) from the Rakuten Advertising publisher dashboard.
RAKUTEN_ADVERTISING_SID=
# Optional override; defaults to https://api.linksynergy.com and posts to /token for OAuth access tokens.
RAKUTEN_ADVERTISING_BASE_URL=https://api.linksynergy.com
# Optional comma/pipe/space-delimited advertiser MIDs to search first.
# When provided, Scent Cast checks advertiser details and skips known non-deep-link advertisers.
RAKUTEN_ADVERTISING_MIDS=
# Optional u1 tracking value appended through the Deep Links API.
RAKUTEN_ADVERTISING_U1=scentcast
# Optional Product Search page size for buy-link resolution; max 100.
RAKUTEN_ADVERTISING_PRODUCT_MAX=10

# Cached affiliate buy-link freshness (optional; backend only)
# Cached affiliate_links rows older than this are treated as stale: they are
# skipped on public share pages (falling back to a search link) and counted by
# GET /api/admin/buy-links/freshness. Defaults to 30 days when unset/invalid.
BUY_LINK_CACHE_TTL_MS=2592000000

# Amazon Associates / Amazon Affiliate
AMAZON_AFFILIATE_ENABLED=false
AMAZON_ASSOCIATE_TAG=
AMAZON_MARKETPLACE=amazon.com

# Optional: only needed for future Amazon Product Advertising API / Creator API integration
AMAZON_ACCESS_KEY_ID=
AMAZON_SECRET_ACCESS_KEY=
AMAZON_PARTNER_TAG=
AMAZON_PARTNER_TYPE=Associates
AMAZON_REGION=us-east-1

# --- Firebase Firestore cache (optional — omit any key to disable cache gracefully) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# PEM contents with literal \n for newlines when stored in a single line
FIREBASE_PRIVATE_KEY=
# Optional Firebase Storage bucket for processed image objects. Production must
# configure Firebase Storage or Supabase Storage; local object refs are not durable.
FIREBASE_STORAGE_BUCKET=
# Optional public CDN/base URL for Firebase Storage objects.
FIREBASE_STORAGE_PUBLIC_BASE_URL=

# --- Supabase Storage image objects (optional backend-only fallback) ---
# Use a service role key only on the backend/Railway. Never expose it through VITE_*.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_IMAGE_BUCKET=
# Optional public CDN/base URL for the image bucket.
SUPABASE_IMAGE_PUBLIC_URL_BASE=

# --- Local image object storage (dev only; never use for production DB refs) ---
# Set this to true only against a disposable/local database.
IMAGE_ALLOW_LOCAL_OBJECT_STORAGE=false
IMAGE_LOCAL_STORAGE_DIR=

# --- Admin ops (backend only — never expose via VITE_* or the browser) ---
# Required for `pnpm --filter @workspace/scripts rebuild-user` and
# POST /api/admin/wardrobe/rebuild (x-admin-secret header). Rotate if leaked.
ADMIN_SECRET=

# --- Google OAuth (optional — omit to get 503 from auth routes) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Canonical site URL for OAuth redirects (no trailing slash). Set when using Cloudflare Tunnel or
# Railway so redirects match Google Console — overrides REPLIT_* when set.
# With Vercel frontend + Railway API, you can leave this unset if the API receives X-Forwarded-Host
# from the proxy; otherwise set to your public Vercel URL (e.g. https://scent-cast-explore.vercel.app).
# Example: https://abc-xyz.trycloudflare.com
OAUTH_PUBLIC_URL=

# Public web app URL (used for OAuth base if OAUTH_PUBLIC_URL unset). Vercel: https://scent-cast-explore.vercel.app
PUBLIC_APP_URL=
FRONTEND_URL=

# Vercel only: origin of the Express API (Railway etc.). Proxied by middleware.js as /api/*.
# Must be one origin only, with no commas and no trailing slash.
# Example: BACKEND_ORIGIN=https://your-railway-api.up.railway.app
BACKEND_ORIGIN=

# --- Replit-only canonical URLs (optional — on Railway/tunnel, clear these or set OAUTH_PUBLIC_URL) ---
REPLIT_DOMAINS=
REPLIT_DEV_DOMAIN=

# --- Logging ---
LOG_LEVEL=info

# --- Frontend: only VITE_* variables are exposed to the browser bundle.
# Optional: bypass Vercel middleware for browser-side /api calls by calling backend directly.
# Must be one origin only, with no commas and no trailing slash. Leave empty to use same-origin /api.
# Example: VITE_API_BASE_URL=https://your-railway-api.up.railway.app
VITE_API_BASE_URL=
# Optional: comma-separated CDN origins/prefixes we control that serve our own
# already-processed image objects (e.g. a Supabase public bucket base or a CDN
# domain fronting it). URLs under these — and any URL containing images/processed/
# — render directly in the browser instead of going through /api/image-proxy.
# Leave empty to rely on the images/processed/ path heuristic alone.
# Example: VITE_IMAGE_CDN_BASES=https://abc.supabase.co/storage/v1/object/public/images
VITE_IMAGE_CDN_BASES=
# Railway Python fragrance engine API. Browser code calls this directly for search/details intelligence.
VITE_FRAGRANCE_API_URL=https://srt-scent-engine-production.up.railway.app
# Server-side proxy target for /api/engine/* (Express). Defaults to VITE_FRAGRANCE_API_URL when unset.
FRAGRANCE_ENGINE_URL=https://srt-scent-engine-production.up.railway.app
# VITE_PUBLIC_APP_NAME=SCENTBEAM
